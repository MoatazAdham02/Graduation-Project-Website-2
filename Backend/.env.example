PORT=4000

# Database where users, scans, and items are stored (Atlas → Browse Collections)
MONGODB_DB_NAME=coronet

# Atlas → Connect → Drivers — use host only in path: ...mongodb.net/?retryWrites=true&w=majority&appName=...
# (Database name comes from MONGODB_DB_NAME, not the URI path.)
MONGODB_URI=

# Required for login/register (any long random string)
JWT_SECRET=

CORS_ORIGIN=http://localhost:5173

# If Atlas is unreachable, the server uses in-memory MongoDB so local dev still works.
# Set to 1 to disable that and exit when the cloud URI fails:
# DISABLE_MEMORY_MONGO_FALLBACK=1
